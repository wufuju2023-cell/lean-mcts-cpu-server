+/-- One fresh value forward per visited, unsolved OR node. AND caches use the
+same unsolved-child min convention, but only for selection. All cache writes
+commit together; any callback/value error leaves the input tree unchanged.
+This does not rewrite history, manufacture visits, change proof flags, priors,
+edges, or the OR/AND training backup functions. -/
+def refreshSelectionValues (control : SelectionValueRefresh) (version step : Nat)
+    (observer? : Option MCTSObserver := none) : SearchM Unit := do
+  let original ← get
+  let saved ← liftM Tactic.saveState
+  try
+    let mut refreshed := original
+    let mut changes : Array Json := #[]
+    -- Reap appends children after their parent; reject a different topology.
+    for (node, index) in original.zipIdx do
+      for (_, child) in node.children do
+        unless index < child && child < original.size do
+          throwError "selection-value-refresh requires the append-only Reap tree topology"
+    for offset in [:original.size] do
+      let index := original.size - 1 - offset
+      let some node := refreshed[index]? | throwError "refresh node out of bounds"
+      if node.data.isSolved || node.data.numVisit == 0 then continue
+      let value ← if node.data.toPlay == .orNode then do
+        node.data.state.restore
+        let goals ← getUnsolvedGoals
+        if goals.isEmpty then
+          throwError "unsolved refresh node has no goals; refusing to change proof state"
+        let value ← control.evalValue goals
+        if value.isNaN || value.isInf || value > 0.0 then
+          throwError "selection-value-refresh requires a finite nonpositive value"
+        pure value
+      else do
+        let mut value := 1.0
+        for (_, childIndex) in node.children do
+          let some child := refreshed[childIndex]? | throwError "refresh child out of bounds"
+          if !child.data.isSolved && child.data.numVisit > 0 then
+            value := min value child.data.selectionValue
+        pure value
+      refreshed := refreshed.set! index { node with data := {
+        node.data with selectionValue? := some (version, value) } }
+      changes := changes.push <| json%{node_index: $index, node_kind: $(node.data.toPlay), value: $value}
+    observe? observer? do
+      return json%{kind: "selection_value_refresh", step: $step,
+        selection_value_version: $version, scope: "selection-only-not-training-Q", nodes: $changes}
+    set refreshed
+  finally
+    saved.restore (restoreInfo := true)
 
